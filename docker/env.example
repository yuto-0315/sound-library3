# Docker の設定の例。
# このファイルを、docker-compose.yml と同じ場所に「.env」という名前でコピーして値を変える。
# （.env は git に入れない）

# ブラウザで開く番号（http://localhost:8080）。ほかのソフトと重なるときに変える
WEB_PORT=8080

# データベースのパスワード（最初に起動する前に変える。起動したあとに変えるときは DOCKER.md を見る）
DB_PASSWORD=change-me-sound-library
DB_ROOT_PASSWORD=change-me-root

# 先生用ページの暗証番号（半角の英数字・記号で 6 文字以上。空なら確認しない）
ADMIN_PIN=

# iPad で録音するとき（HTTPS）の設定。start-docker-https.bat は HOST_IP を自動で入れる
HOST_IP=
HTTPS_PORT=8443
CERT_PORT=8081
